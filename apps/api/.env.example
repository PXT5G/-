PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/gulfos
JWT_SECRET=gulfos-dev-secret-change-in-production
JWT_REFRESH_SECRET=gulfos-dev-refresh-secret-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Integration Foundation V1 (optional — required for external service auth)
SERVICE_AUTH_TOKEN=
SERVICE_AUTH_TOKEN_PREVIOUS=
TOKEN_ENCRYPTION_KEY=
